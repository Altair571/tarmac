<?xml version="1.0" encoding="utf-8"?>
<!-- A dialog leaves faster than it came, and does not move far. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/accelerate_quad" android:shareInterpolator="true">
    <scale android:duration="140" android:fromXScale="1" android:fromYScale="1" android:toXScale="0.97" android:toYScale="0.97"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:duration="140" android:fromAlpha="1" android:toAlpha="0" />
</set>
