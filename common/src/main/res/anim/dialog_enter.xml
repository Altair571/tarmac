<?xml version="1.0" encoding="utf-8"?>
<!-- A dialog comes forward: it grows the last few percent and settles, as Motion.enter does in code. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_quint" android:shareInterpolator="true">
    <scale android:duration="260" android:fromXScale="0.94" android:fromYScale="0.94" android:toXScale="1" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:duration="180" android:fromAlpha="0" android:toAlpha="1" />
</set>
