    <string name="settings_reverse_camera_source_byd">比亚迪挡位（ADB）</string>
    <string name="settings_reverse_camera_source_ecarx">吉利 / ECARX 传感器</string>
    <string name="settings_reverse_camera_source_adapter">车辆数据适配器</string>
    <string name="settings_reverse_camera_source_broadcast">车机广播</string>
    <string name="settings_reverse_camera_source_none">Tarmac 不知道这台车机的挡位来源。请在车辆数据适配器（高级）中加入挡位信号，或设置车机的广播。</string>
    <string name="settings_reverse_camera_source_using">挡位读取自：%1$s</string>
