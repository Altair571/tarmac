<resources>
    <string name="settings_reverse_camera">倒车影像</string>
    <string name="settings_reverse_camera_switch">倒车时切换到摄像头</string>
    <string name="settings_reverse_camera_switch_description">车辆挂入倒挡时，Tarmac 会把 CarPlay 移出屏幕，或打开下方选择的摄像头应用；退出倒挡后再把 CarPlay 切回来。CarPlay 保持连接。</string>
    <string name="settings_reverse_camera_source">挡位来源</string>
