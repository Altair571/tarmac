    <!-- Car data for the Vehicle app (CarPlayCarData). -->
    <string name="settings_carplay_ultra_car_data">车辆应用中的车辆数据</string>
    <string name="settings_carplay_ultra_car_data_description">在 CarPlay 的车辆应用中显示 Tarmac 已从车辆读取的数据，例如电量或燃油、续航里程、总里程、轮胎和车外温度。只读：不会向车辆发送任何内容。每项数值在此车机上的数据源（BYD ADB、车辆数据适配器或 TEYES 车机）提供过一次后才会显示。下次连接时生效。</string>
    <string name="settings_carplay_ultra_car_data_next">下次连接：%1$s</string>
    <string name="settings_carplay_ultra_car_data_none">暂无数据。此车机上的数据源（BYD ADB、车辆数据适配器或 TEYES 车机）提供某项数值后，从下一次连接起显示。</string>
