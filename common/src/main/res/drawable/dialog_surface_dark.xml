<?xml version="1.0" encoding="utf-8"?>
<!-- A dialog is a card: the card's colour, corner and hairline, inset from the screen's edge. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="16dp">
    <shape android:shape="rectangle">
        <solid android:color="@color/dialog_background_dark" />
        <corners android:radius="24dp" />
        <stroke android:width="1dp" android:color="@color/dialog_hairline_dark" />
    </shape>
</inset>
